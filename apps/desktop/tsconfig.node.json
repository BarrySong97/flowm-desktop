{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "vite.sidecar.config.ts",
    "src/main/**/*.ts",
    "src/tauri-sidecar/**/*.ts"
  ]
}
